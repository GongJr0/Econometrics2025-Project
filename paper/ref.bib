@article{maccarrone_gdp_2021,
	title = {{GDP} {Forecasting}: {Machine} {Learning}, {Linear} or {Autoregression}?},
	volume = {4},
	issn = {2624-8212},
	shorttitle = {{GDP} {Forecasting}},
	url = {https://www.frontiersin.org/journals/artificial-intelligence/articles/10.3389/frai.2021.757864/full},
	doi = {10.3389/frai.2021.757864},
	abstract = {This paper evaluates the predictive power of different models to forecast the real U.S. GDP. Using quarterly U.S. GDP data from 1976 to 2020 we find that the machine learning K-Nearest Neighbour (KNN) model captures the self-predictive ability of the U.S. GDP and performs better than traditional time series analysis. We explore whether predictors such as the yield curve, its latent factors, and a set of macroeconomic variables can increase the level of forecasting accuracy. The predictions result to be improved only when considering longer forecast horizons. The use of machine learning algorithm provide additional guidance for data-driven decision making.},
	language = {English},
	urldate = {2025-12-08},
	journal = {Frontiers in Artificial Intelligence},
	author = {Maccarrone, Giovanni and Morelli, Giacomo and Spadaccini, Sara},
	month = oct,
	year = {2021},
	note = {Publisher: Frontiers},
	keywords = {paper, Forecasting strategies, GDP, KNN (k nearest neighborhood), machine learning, time series},
	file = {Full Text PDF:C\:\\Users\\guney\\Zotero\\storage\\4YFKGZD4\\Maccarrone et al. - 2021 - GDP Forecasting Machine Learning, Linear or Autoregression.pdf:application/pdf},
}

@article{mandel_relationship_2019,
	title = {The {Relationship} between {GDP} and {Unemployment} {Rate} in the {U}.{S}.},
	volume = {10},
	issn = {22191933, 22196021},
	url = {http://ijbssnet.com/journal/index/4210},
	doi = {10.30845/ijbss.v10n4p3},
	abstract = {Gross Domestic Product (GDP) and unemployment rate are two key figures to determine a country’s degree of prosperity. High unemployment rate shows that the labor availability is not used efficiently. This paper observes the correlation between the Gross Domestic Product and the unemployment rate in the U.S. - over a long period of time, i.e. 50 years. By using an econometric model we run multiple regression analysis to test our hypothesis that is that a decreasing GDP rate through slow economic growth leads to an increasing unemployment rate. Supported by a review of relevant literature we discover a continuously existing negative correlation between the GDP and the unemployment in the U.S. over the last fifty years.},
	language = {en},
	number = {4},
	urldate = {2025-12-08},
	journal = {International Journal of Business and Social Science},
	author = {Mandel, Dr. Claudius and Liebens, Peter},
	year = {2019},
	keywords = {paper},
	file = {PDF:C\:\\Users\\guney\\Zotero\\storage\\A2FHLTEP\\Mandel and Liebens - 2019 - The Relationship between GDP and Unemployment Rate in the U.S..pdf:application/pdf},
}

@article{ferrentino_mathematical_2020,
	title = {A {Mathematical} {Model} for the {Study} of the {Effects} of the {Economic} {Cycle} on the {Real} {GDP} {Growth} {Rate} through the {Expectations}-{Adjusted} {Phillips} {Curve}},
	volume = {10},
	copyright = {Copyright (c) 2020 International Journal of Economics and Financial Issues},
	issn = {2146-4138},
	url = {https://www.econjournals.com/index.php/ijefi/article/view/9236},
	abstract = {In this paper is presented a theoretical model finalized to explain the effects of the economic cycle on the real GDP growth rate of a given country's economy towards a selected business partner. In other words, the present paper expose an innovative theoretical model, based on the expectations-adjusted Phillips Curve and on the Okun's law, which proposes the existence of a relationship between the difference in the effective inflation rate and in the expected inflation rate of the national economy of a generic country (inflation gap), and the growth rate of the real GDP of the national economy and of its corresponding commercial partner, both determined by the different phases of the economic cycle. The two economies examined, for the purpose of empirical verification, are Germany and the group of the countries belonging to the euro area, considered, as a whole, as a single economy. The considered sample period ranges from  the first quarter of 1999 to the first quarter of 2018. The result to which the authors arrive, appropriately verified with econometric models, indicates not only the existence, the significance and the robustness of the relationship established by it but also the ability of the model to predict, with good precision, the effects of the economic cycle on the real GDP growth rate, given the inflation gap.Keywords: Expectations-adjusted Phillips Curve, Okun's Law, Business Cycle, mathematical models and methods.JEL Classifications: C02, C32, E32, E37DOI: https://doi.org/10.32479/ijefi.9236},
	language = {en},
	number = {2},
	urldate = {2026-01-12},
	journal = {International Journal of Economics and Financial Issues},
	author = {Ferrentino, Rosa and Vota, Luca},
	month = mar,
	year = {2020},
	keywords = {paper},
	pages = {222--234},
	file = {Full Text PDF:C\:\\Users\\guney\\Zotero\\storage\\YHKUDSS5\\Ferrentino and Vota - 2020 - A Mathematical Model for the Study of the Effects of the Economic Cycle on the Real GDP Growth Rate.pdf:application/pdf},
}

@article{tauber_growth-augmented_2020,
	title = {A {Growth}-{Augmented} {Phillips} {Curve}},
	url = {https://www.clevelandfed.org/publications/economic-commentary/2020/ec-202016-growth-augmented-phillips-curve},
	doi = {10.26509/frbc-ec-202016},
	abstract = {Empirical studies find that the link between inflation and economic slack has weakened in recent decades, a development that could hamper monetary policymakers as they aim to achieve their inflation objective. We show that while the role of economic slack has diminished, economic growth has become a significant driver of inflation dynamics, indicating that the link between inflation and economic activity remains but the relevant gauge of activity has changed. The new evidence suggests that the COVID-19-related recession could induce substantial disinflationary pressure.},
	language = {en},
	number = {2020-16},
	urldate = {2026-01-12},
	journal = {Economic Commentary},
	author = {Tauber, Kristen and Van Zandweghe, Willem},
	month = jul,
	year = {2020},
	note = {Publisher: Federal Reserve Bank of Cleveland},
	keywords = {paper},
	file = {Full Text PDF:C\:\\Users\\guney\\Zotero\\storage\\XRE328F9\\Tauber and Van Zandweghe - 2020 - A Growth-Augmented Phillips Curve.pdf:application/pdf},
}
